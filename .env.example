# GEMINI_API_KEY: Required for Gemini AI API calls
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Base URL where this application is hosted
APP_URL="http://localhost:3000"

# Supabase Credentials:
# Copy from Supabase Project Settings > API
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# Hostinger SMTP Configuration (Free Hostinger Email):
# Hostinger hPanel > Emails > Email Accounts
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER="noreply@yourdomain.com"
SMTP_PASS="your-hostinger-email-password"
SMTP_FROM_NAME="UDM ResearchHub"
